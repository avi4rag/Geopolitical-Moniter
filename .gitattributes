# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Force these to always use LF
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.env   text eol=lf

# Binary files - leave alone
*.png   binary
*.jpg   binary
*.ico   binary
*.svg   text eol=lf
