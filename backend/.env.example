# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Get from MongoDB Atlas → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/geopolitical_monitor?retryWrites=true&w=majority

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Get from platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# ── The Guardian API ─────────────────────────────────────────────────────────
# Get from https://open-platform.theguardian.com/access/ (free)
GUARDIAN_API_KEY=your-guardian-api-key

# ── NewsAPI.org ───────────────────────────────────────────────────────────────
# Get from https://newsapi.org/register (free developer plan)
NEWS_API_KEY=your-newsapi-key

# ── Ingestion Settings ───────────────────────────────────────────────────────
# Relevance score threshold (0.0 - 1.0). Articles below this skip LLM.
RELEVANCE_THRESHOLD=0.3
# Max processing attempts before permanent failure
MAX_PROCESSING_ATTEMPTS=3
# Ingestion cron schedule (default: every 2 hours)
INGESTION_CRON=0 */2 * * *

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Admin Route Protection ────────────────────────────────────────────────────
# Required in production. Send as X-Admin-Secret header.
# Not needed in development (all admin routes are open).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace-with-a-strong-random-secret
