# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Get from MongoDB Atlas → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/geopolitical_monitor?retryWrites=true&w=majority

# ── Gemini / LLM Provider ────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# ── Google OAuth 2.0 / OpenID Connect ─────────────────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI must be: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── News Providers ───────────────────────────────────────────────────────────
# Get from https://open-platform.theguardian.com/access/ (free)
GUARDIAN_API_KEY=your-guardian-api-key
# Get from https://newsapi.org/register (free developer plan)
NEWS_API_KEY=your-newsapi-key

# ── Ingestion & Cron Settings ────────────────────────────────────────────────
RELEVANCE_THRESHOLD=0.3
MAX_PROCESSING_ATTEMPTS=3
INGESTION_CRON=0 */2 * * *
ENABLE_CRON=false

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
